# =============================================================
# ObraIA — variáveis de ambiente
# Copie para .env e preencha. Nunca versione o .env preenchido.
# =============================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Banco de dados -----------------------------------------
DATABASE_URL=postgresql://obraia:obraia@localhost:5432/obraia

# --- Redis (fila BullMQ + cache de sessão) ------------------
REDIS_URL=redis://localhost:6379

# --- WhatsApp Business Platform (Meta Cloud API) ------------
# Painel: https://developers.facebook.com > seu app > WhatsApp > API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Segredo do app, usado para validar a assinatura X-Hub-Signature-256
WHATSAPP_APP_SECRET=
# Token que VOCÊ inventa e repete no painel da Meta ao cadastrar o webhook
WHATSAPP_VERIFY_TOKEN=troque-este-valor
WHATSAPP_API_VERSION=v21.0

# --- Provedor de IA -----------------------------------------
# openai | anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIPTION_MODEL=whisper-1
# Usado apenas quando AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Autenticação do painel ---------------------------------
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=7d

# --- Armazenamento de mídia ---------------------------------
# local | s3
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
S3_BUCKET=
S3_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Dias de retenção de áudio/imagem originais (LGPD). 0 = manter indefinidamente.
MEDIA_RETENTION_DAYS=180

# --- Painel web ---------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3000
