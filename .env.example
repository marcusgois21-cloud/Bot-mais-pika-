# Token do bot Discord (obtenha em https://discord.com/developers/applications)
TOKEN=seu_token_aqui

# ID do seu bot (Client ID)
CLIENT_ID=seu_client_id_aqui

# ID do servidor (opcional, para deploy de comandos em servidor específico)
# GUILD_ID=id_do_servidor_aqui

# Chave da API Anthropic (opcional — habilita análise de IA, moderação contextual)
# Obtenha em: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-...
