{
  "name": "gois-group-site",
  "version": "1.0.0",
  "private": true,
  "description": "Site oficial da Gois Group",
  "scripts": {
    "predev": "node scripts/derive-tokens.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/derive-tokens.mjs && node scripts/check-content.mjs",
    "build": "next build",
    "postbuild": "node scripts/measure-build.mjs",
    "build:homolog": "node scripts/derive-tokens.mjs && node scripts/check-content.mjs && NEXT_PUBLIC_SHOW_PENDING=1 next build && node scripts/measure-build.mjs",
    "start": "npx --yes serve out",
    "typecheck": "node scripts/derive-tokens.mjs && tsc --noEmit",
    "pendencias": "node scripts/check-content.mjs --listar",
    "marca": "python3 scripts/build-marca.py",
    "predeploy": "node scripts/checar-sinais.mjs",
    "icones": "node scripts/gerar-icones.mjs",
    "og": "node scripts/gerar-og.mjs"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "next": "^16.3.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
